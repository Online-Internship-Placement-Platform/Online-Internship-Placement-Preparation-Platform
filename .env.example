# Database connection (required by Prisma and the application)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=your_mariadb_user
DATABASE_PASSWORD=your_mariadb_password
DATABASE_NAME=inplace
MIGRATOR_DATABASE_URL=mysql://your_mariadb_user:your_mariadb_password@localhost:3306/inplace

# Both session implementations use the same signing secret during the merge.
# Replace this placeholder with a random value of at least 32 characters.
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
