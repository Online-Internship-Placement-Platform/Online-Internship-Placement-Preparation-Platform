## Default ignored items for next.js apps
# dependencies
/node_modules
# Prisma setup (temporarily keep out of Git)
/prisma/
/prisma7.config.ts
/generated/prisma/
/src/lib/prisma.ts
/src/prisma_test_script.ts
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep secrets local; allow a safe template to be committed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
