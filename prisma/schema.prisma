// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

//Account management
enum Role {
  STUDENT     @map("student")
  ADMIN       @map("admin")
  SUPER_ADMIN @map("super-admin")
}

enum YearOfStudy {
  FIRST
  SECOND
  THIRD
  FOURTH
}

enum AccountRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id             Int             @id @default(autoincrement())
  name           String?         @db.VarChar(150)
  email          String          @unique @db.VarChar(255)
  // Legacy accounts remain nullable until a password has been securely provisioned.
  passwordHash   String?         @db.VarChar(255)
  role           Role            @default(STUDENT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  studentProfile StudentProfile?
  applications   Application[]
}

model StudentProfile {
  id          Int         @id @default(autoincrement())
  userId      Int         @unique
  branch      String      @db.VarChar(150)
  cgpa        Float
  yearOfStudy YearOfStudy
  skills      Json
  resumeData  Bytes?      @db.MediumBlob
  resumeFileName String?  @db.VarChar(255)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccountCreationRequest {
  id           Int                  @id @default(autoincrement())
  name         String               @db.VarChar(150)
  email        String               @unique @db.VarChar(255)
  passwordHash String               @db.VarChar(255)
  role         Role
  status       AccountRequestStatus @default(PENDING)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, createdAt])
}

//Placement testing
enum PlacementDomain {
  WEB_DEVELOPMENT
  AI_ML
  CORE_CS
  NETWORKS
  DATABASES
}

enum PlacementDifficulty {
  EASY
  MEDIUM
  HARD
}

enum AnswerOption {
  A
  B
  C
  D
}

model Question {
  id            Int                 @id @default(autoincrement())
  prompt        String              @db.Text
  optionA       String              @db.Text
  optionB       String              @db.Text
  optionC       String              @db.Text
  optionD       String              @db.Text
  correctOption AnswerOption
  domain        PlacementDomain
  difficulty    PlacementDifficulty
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  tests         TestQuestion[]
}

model PlacementTest {
  id          Int                 @id @default(autoincrement())
  title       String              @db.VarChar(191)
  description String?             @db.Text
  domain      PlacementDomain
  difficulty  PlacementDifficulty
  isDefault   Boolean             @default(false)
  isPublished Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  questions   TestQuestion[]
  attempts    TestAttempt[]
}

model TestQuestion {
  testId     Int
  questionId Int
  order      Int
  test       PlacementTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  question   Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([testId, questionId])
  @@unique([testId, order])
  @@index([questionId])
}

model TestAttempt {
  id             Int           @id @default(autoincrement())
  studentId      String // email of the authenticated demo account
  testId         Int
  correctCount   Int
  totalQuestions Int
  percentage     Float
  answers        Json
  completedAt    DateTime      @default(now())
  test           PlacementTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([studentId, testId])
  @@index([studentId, completedAt])
}

//Internship and application management
model Internship {
  id                    String        @id
  company               String
  role                  String
  applicationDeadline   DateTime      @db.Date
  published             Boolean       @default(false)
  acceptingApplications Boolean       @default(false)
  minCgpa               Float         @default(0)
  eligibleBranches      String        @db.Text
  requiredSkills        String        @default("") @db.VarChar(2048)
  applications          Application[]
}

model Application {
  id               Int        @id @default(autoincrement())
  studentId        Int
  internshipId     String
  status           String     @default("Pending")
  appliedAt        DateTime   @default(now())
  resumeStorageKey String?
  student          User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  internship       Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@unique([studentId, internshipId])
  @@index([internshipId])
}

model AccountCreationRequest {
  id           Int                  @id @default(autoincrement())
  name         String               @db.VarChar(150)
  email        String               @unique @db.VarChar(255)
  passwordHash String               @db.VarChar(255)
  role         Role
  status       AccountRequestStatus @default(PENDING)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, createdAt])
}