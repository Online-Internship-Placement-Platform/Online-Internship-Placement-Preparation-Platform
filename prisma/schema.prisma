// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  STUDENT     @map("student")
  ADMIN       @map("admin")
  SUPER_ADMIN @map("super-admin")
}

enum YearOfStudy {
  FIRST
  SECOND
  THIRD
  FOURTH
}

model User {
  id             Int             @id @default(autoincrement())
  name           String?         @db.VarChar(150)
  email          String          @unique @db.VarChar(255)
  // Legacy accounts remain nullable until a password has been securely provisioned.
  passwordHash   String?         @db.VarChar(255)
  role           Role            @default(STUDENT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  studentProfile StudentProfile?
  posts          Post[]
  applications   Application[]
}

model StudentProfile {
  id          Int         @id @default(autoincrement())
  userId      Int         @unique
  branch      String      @db.VarChar(150)
  cgpa        Float
  yearOfStudy YearOfStudy
  skills      Json
  resumeData  Bytes?      @db.MediumBlob
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  content   String? @db.Text
  published Boolean @default(false)
  author    User    @relation(fields: [authorId], references: [id])
  authorId  Int
}

model Internship {
  id                    String        @id
  company               String
  role                  String
  applicationDeadline   DateTime      @db.Date
  published             Boolean       @default(false)
  acceptingApplications Boolean       @default(false)
  minCgpa               Float         @default(0)
  eligibleBranches      String        @db.Text
  requiredSkills        String        @default("") @db.VarChar(2048)
  applications          Application[]
}

model Application {
  id               Int        @id @default(autoincrement())
  studentId        Int
  internshipId     String
  status           String     @default("Pending")
  appliedAt        DateTime   @default(now())
  resumeStorageKey String?
  student          User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  internship       Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@unique([studentId, internshipId])
  @@index([internshipId])
}
